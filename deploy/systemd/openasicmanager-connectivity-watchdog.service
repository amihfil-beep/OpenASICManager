[Unit]
Description=OpenASICManager connectivity watchdog (VPN and farm)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

User=openasicmanager
Group=openasicmanager

WorkingDirectory=/opt/openasicmanager
EnvironmentFile=-/etc/openasicmanager/openasicmanager.env

ExecStart=/opt/openasicmanager/venv/bin/python /opt/openasicmanager/scripts/openasicmanager-connectivity-watchdog

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openasicmanager

# Prevent a network stall from overlapping future timer invocations.
TimeoutStartSec=25s
