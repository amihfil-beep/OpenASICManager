[Unit]
Description=OpenASICManager Remote Web nginx synchronization
After=openasicmanager.service nginx.service
Wants=nginx.service
PartOf=openasicmanager.service
ConditionPathExists=/opt/openasicmanager/scripts/openasicmanager-remote-web-sync
ConditionPathExists=/usr/sbin/nginx

[Service]
Type=oneshot
User=root
Group=root

ExecStart=/opt/openasicmanager/venv/bin/python /opt/openasicmanager/scripts/openasicmanager-remote-web-sync

UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/nginx/sites-available /etc/nginx/sites-enabled
