#!/usr/bin/env python3

import argparse
import os
from pathlib import Path
import subprocess
import sys


PROJECT_ROOT = (
    Path(__file__)
    .resolve()
    .parent
    .parent
)

APP_DIR = (
    PROJECT_ROOT
    / "app"
)

DEFAULT_ENV_FILE = Path(
    "/etc/openasicmanager/openasicmanager.env"
)


def _env_file_from_argv(argv):
    for index, argument in enumerate(
        argv
    ):
        if argument == "--env-file":
            if index + 1 < len(argv):
                return Path(
                    argv[
                        index + 1
                    ]
                )

        if argument.startswith(
            "--env-file="
        ):
            return Path(
                argument.split(
                    "=",
                    1,
                )[1]
            )

    return DEFAULT_ENV_FILE


def _load_env_file(path):
    path = Path(path)

    if not path.is_file():
        return

    for raw in path.read_text(
        encoding="utf-8"
    ).splitlines():
        line = raw.strip()

        if (
            not line
            or
            line.startswith("#")
            or
            "=" not in line
        ):
            continue

        key, value = line.split(
            "=",
            1,
        )

        key = key.strip()
        value = value.strip()

        if (
            len(value) >= 2
            and
            value[0] == value[-1]
            and
            value[0] in (
                '"',
                "'",
            )
        ):
            value = value[
                1:-1
            ]

        if key:
            os.environ.setdefault(
                key,
                value,
            )


ENV_FILE = _env_file_from_argv(
    sys.argv[1:]
)

_load_env_file(
    ENV_FILE
)

sys.path.insert(
    0,
    str(
        APP_DIR
    ),
)

from app_version import APP_VERSION
from config import DATABASE_PATH
from maintenance.backup import (
    DEFAULT_BACKUP_ROOT,
    create_backup,
    restore_backup,
    verify_backup,
)


def _require_root():
    if os.geteuid() != 0:
        raise RuntimeError(
            "This operation must be run as root"
        )


def _service_is_active(
    service_name,
):
    try:
        result = subprocess.run(
            [
                "systemctl",
                "is-active",
                "--quiet",
                service_name,
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        return False

    return result.returncode == 0


def _build_parser():
    parser = argparse.ArgumentParser(
        description=(
            "Create, verify and restore "
            "OpenASICManager backup sets"
        )
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    create_parser = subparsers.add_parser(
        "create",
        help=(
            "Create a consistent online backup"
        ),
    )

    create_parser.add_argument(
        "--backup-root",
        default=str(
            DEFAULT_BACKUP_ROOT
        ),
        help=(
            "Directory that will contain "
            "versioned backup sets"
        ),
    )

    create_parser.add_argument(
        "--database",
        default=DATABASE_PATH,
        help=(
            "SQLite database path"
        ),
    )

    create_parser.add_argument(
        "--env-file",
        default=str(
            ENV_FILE
        ),
        help=(
            "OpenASICManager environment file"
        ),
    )

    verify_parser = subparsers.add_parser(
        "verify",
        help=(
            "Verify manifest checksums and "
            "SQLite integrity"
        ),
    )

    verify_parser.add_argument(
        "backup",
        help="Backup set directory",
    )

    restore_parser = subparsers.add_parser(
        "restore",
        help=(
            "Restore database and optional "
            "environment configuration"
        ),
    )

    restore_parser.add_argument(
        "backup",
        help="Backup set directory",
    )

    restore_parser.add_argument(
        "--database",
        default=DATABASE_PATH,
        help=(
            "SQLite database destination"
        ),
    )

    restore_parser.add_argument(
        "--env-file",
        default=str(
            ENV_FILE
        ),
        help=(
            "Environment file destination"
        ),
    )

    restore_parser.add_argument(
        "--service-name",
        default=(
            "openasicmanager.service"
        ),
        help=(
            "Service that must be stopped "
            "before restore"
        ),
    )

    restore_parser.add_argument(
        "--allow-active-service",
        action="store_true",
        help=(
            "Override the active-service "
            "restore safety check"
        ),
    )

    restore_parser.add_argument(
        "--yes",
        action="store_true",
        help=(
            "Confirm the state-changing "
            "restore operation"
        ),
    )

    return parser


def main():
    parser = _build_parser()
    args = parser.parse_args()

    try:
        if args.command == "create":
            _require_root()

            backup = create_backup(
                database_path=(
                    args.database
                ),
                env_file=(
                    args.env_file
                ),
                backup_root=(
                    args.backup_root
                ),
                source_version=(
                    APP_VERSION
                ),
            )

            print(
                "Backup created: "
                + str(backup)
            )

            print(
                "Source version: "
                + APP_VERSION
            )

            return 0

        if args.command == "verify":
            manifest = verify_backup(
                args.backup
            )

            print(
                "Backup verified: "
                + str(
                    Path(
                        args.backup
                    ).resolve()
                )
            )

            print(
                "Source version: "
                + str(
                    manifest.get(
                        "source_version",
                        "unknown",
                    )
                )
            )

            return 0

        if args.command == "restore":
            _require_root()

            if not args.yes:
                raise RuntimeError(
                    "Restore requires explicit "
                    "confirmation with --yes"
                )

            if (
                not args.allow_active_service
                and
                _service_is_active(
                    args.service_name
                )
            ):
                raise RuntimeError(
                    "Refusing to restore while "
                    + args.service_name
                    + " is active. Stop the service "
                    "first or explicitly use "
                    "--allow-active-service."
                )

            result = restore_backup(
                args.backup,
                database_path=(
                    args.database
                ),
                env_file=(
                    args.env_file
                ),
            )

            print(
                "Restore completed."
            )

            print(
                "Source version: "
                + str(
                    result[
                        "source_version"
                    ]
                )
            )

            print(
                "Database: "
                + result[
                    "database"
                ]
            )

            print(
                "Environment restored: "
                + (
                    "yes"
                    if result[
                        "environment_restored"
                    ]
                    else "no"
                )
            )

            return 0

        parser.error(
            "Unknown command"
        )

    except RuntimeError as exc:
        print(
            "ERROR: "
            + str(exc),
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(
        main()
    )
