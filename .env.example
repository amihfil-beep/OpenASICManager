# ============================================================
# OpenASICManager configuration
#
# Copy to:
#   /etc/openasicmanager/openasicmanager.env
#
# Never commit the real environment file.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

ASIC_MANAGER_NAME=OpenASICManager
ASIC_MANAGER_DB=/var/lib/openasicmanager/openasicmanager.db
ASIC_MANAGER_TIMEZONE=UTC


# ------------------------------------------------------------
# ASIC credentials
#
# Passwords intentionally have no defaults.
# ------------------------------------------------------------

BITMAIN_USERNAME=root
BITMAIN_PASSWORD=

AWESOME_USERNAME=
AWESOME_PASSWORD=


# ------------------------------------------------------------
# Discovery
# ------------------------------------------------------------

ASIC_DISCOVERY_DEFAULT_NETWORK=192.168.1.0/24
ASIC_DISCOVERY_MAX_HOSTS=4094


# ------------------------------------------------------------
# Remote ASIC Web
# ------------------------------------------------------------

REMOTE_WEB_ENABLED=false
REMOTE_WEB_BASE_DOMAIN=manager.example.com

# Example:
# REMOTE_WEB_COOKIE_DOMAIN=.miners.example.com
REMOTE_WEB_COOKIE_DOMAIN=

REMOTE_WEB_ALLOWED_CIDR=192.168.1.0/24
REMOTE_WEB_SECRET=
REMOTE_WEB_TTL=1800


# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional:
# socks5h://127.0.0.1:1080
TELEGRAM_PROXY=


# ------------------------------------------------------------
# Public Web
# ------------------------------------------------------------

PUBLIC_DOMAIN=manager.example.com


# Certificate used for Remote ASIC Web.
#
# A wildcard certificate is recommended:
#   *.manager.example.com
#
# Alternatively, a SAN certificate containing every generated
# miner hostname can be used.
#
REMOTE_WEB_CERT=
REMOTE_WEB_KEY=
