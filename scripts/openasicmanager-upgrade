#!/usr/bin/env python3

import argparse
import json
import os
from pathlib import Path
import sys

PROJECT_ROOT = Path(__file__).resolve().parent.parent
APP_DIR = PROJECT_ROOT / "app"
sys.path.insert(0, str(APP_DIR))

import maintenance.upgrade as upgrade_module
from maintenance.remote_web_sync import register_upgrade_units

UpgradeConfig = upgrade_module.UpgradeConfig
perform_upgrade = upgrade_module.perform_upgrade


def _parser():
    parser = argparse.ArgumentParser(
        description="Transactionally upgrade a public OpenASICManager installation"
    )
    parser.add_argument(
        "--source",
        default=str(PROJECT_ROOT),
        help="Extracted target release/source tree (default: this tree)",
    )
    parser.add_argument(
        "--health-timeout",
        type=int,
        default=45,
        help="Seconds to wait for post-upgrade and rollback health checks",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit the success report as JSON",
    )
    parser.add_argument(
        "--yes",
        action="store_true",
        help="Confirm the state-changing upgrade operation",
    )
    return parser


def main():
    args = _parser().parse_args()

    if os.geteuid() != 0:
        print("ERROR: run this upgrade command as root", file=sys.stderr)
        return 2

    if not args.yes:
        print("ERROR: upgrade requires explicit --yes", file=sys.stderr)
        return 2

    if args.health_timeout <= 0:
        print("ERROR: --health-timeout must be positive", file=sys.stderr)
        return 2

    source_root = Path(args.source)

    try:
        register_upgrade_units(
            upgrade_module,
            source_root,
        )
    except RuntimeError as exc:
        print("ERROR:", str(exc), file=sys.stderr)
        return 1

    config = UpgradeConfig(
        source_root=source_root,
        health_timeout=args.health_timeout,
    )

    try:
        report = perform_upgrade(config)
    except RuntimeError as exc:
        print("ERROR:", str(exc), file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(
            "OpenASICManager upgrade complete:"
            f" {report['from_version']} -> {report['to_version']}"
        )
        print("Backup:", report["backup_dir"])
        print("Preflight:", str(report["preflight_status"]).upper())
        print("Postflight:", str(report["postflight_status"]).upper())

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
